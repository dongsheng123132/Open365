    "spec_version":  "0.1.0",
    "application":  {
                        "id":  "org.open365.maintenance",
                        "name":  "Open365",
                        "version":  "1.2.2",
                        "description":  "无广告、无捆绑、不联网上传的 Windows 维护工具：GUI、CLI 与 AI 共用同一个动作核心。",
                        "source":  "https://github.com/dongsheng123132/Open365"
                    },
    "conformance_targets":  [
                                "AP-1",
                                "AP-2"
